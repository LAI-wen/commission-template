{
  "name": "commission-template",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-adapter.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "update": "npm run build && wrangler pages deploy .svelte-kit/cloudflare",
    "cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
    "test": "node --test scripts/changelog.test.mjs scripts/backup.test.mjs",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.6.2",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "arctic": "^3.7.0",
    "browser-image-compression": "^2.0.2",
    "fflate": "^0.8.3",
    "hono": "^4.12.18",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.3",
    "nanoid": "^5.1.11",
    "oslo": "^1.2.1",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  }
}
